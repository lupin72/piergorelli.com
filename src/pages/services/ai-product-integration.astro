---
import { CAL_URL } from "../../data/site";
import Base from "../../layouts/Base.astro";
import ServiceFigure from "../../components/rd/ServiceFigure.astro";
import WorkVisual from "../../components/rd/WorkVisual.astro";

const SITE = "https://piergorelli.com";
const PAGE = `${SITE}/services/ai-product-integration/`;
const updated = new Date("2026-09-30");

const pains = [
  { pain: "The demo chatbot invented a discount code.", fix: "Answers are grounded on the client's own content, cite their sources, and say “I don't know” when nothing fits." },
  { pain: "Nobody can tell if it's getting better or worse.", fix: "An eval set of real customer questions from day one, re-run on every change, with scores in a written report." },
  { pain: "The API bill tripled in a month.", fix: "A monthly cost cap, cost per conversation in the eval report, and an alert before the budget runs out." },
  { pain: "Legal blocked it a week before launch.", fix: "Data flows mapped at kick-off: what goes where, what never leaves the client's systems, where the models run. Written down, ready for the DPO." },
];

const builds = [
  { n: "01", title: "A chatbot on your content", body: "Assistants that answer from the client's catalogue, policies and docs, cite the page they used and hand over to a human when they should." },
  { n: "02", title: "Semantic search", body: "Search that understands “waterproof jacket for the Pyrenees in March”: hybrid keyword and vector search across products, articles and knowledge bases." },
  { n: "03", title: "Answers from PDFs and catalogues", body: "Technical sheets, price lists and manuals turned into answers that point to the document and page they came from." },
  { n: "04", title: "AI inside WordPress", body: "Tagging, translation, product descriptions, alt text and internal search in WordPress and WooCommerce, inside the editor the team already uses." },
  { n: "05", title: "Evals & guardrails", body: "Test sets, refusal rules, prompt-injection checks, cost and quality dashboards. Also as an audit of an AI feature someone else built." },
];

// Retrieval lab: CSS only. Demo data from a fictional outdoor shop; scores are an illustrative replay.
const questions = [
  { id: "ship", q: "Do you ship to the Canary Islands?" },
  { id: "return", q: "Can I return a jacket I bought on sale?" },
  { id: "everest", q: "Is the Trail 3L good enough for Everest?" },
] as const;
type Q = (typeof questions)[number]["id"];
const THRESHOLD = 0.75;

const sources: { file: string; text: string; s: Record<Q, number> }[] = [
  { file: "shipping.md § islands", text: "We ship to the Canary Islands in 5–7 working days. Customs are included in the price.", s: { ship: 0.91, return: 0.21, everest: 0.08 } },
  { file: "shipping.md § mainland", text: "Free delivery in mainland Spain on orders over €60, in 24–48 h.", s: { ship: 0.78, return: 0.19, everest: 0.06 } },
  { file: "returns.md § sale items", text: "Sale items can be returned within 14 days, unworn and with their tags.", s: { ship: 0.33, return: 0.89, everest: 0.11 } },
  { file: "returns.md § refunds", text: "Refunds go back to the original payment method within 5 working days.", s: { ship: 0.41, return: 0.8, everest: 0.07 } },
  { file: "products/trail-3l", text: "Trail 3L jacket: 3-layer membrane, 20,000 mm waterproof rating, 380 g.", s: { ship: 0.12, return: 0.52, everest: 0.63 } },
  { file: "size-guide.md", text: "Jackets run small: between two sizes, choose the larger one.", s: { ship: 0.09, return: 0.38, everest: 0.44 } },
];
const hits = (q: Q) => sources.map((src, i) => (src.s[q] >= THRESHOLD ? i : -1)).filter((i) => i >= 0);
const cite = (i: number) => `[0${i + 1}]`;

const answers: Record<Q, { text: string; trace: string }> = {
  ship: {
    text: `Yes. Orders to the Canary Islands arrive in 5–7 working days, and customs are already included in the price ${cite(0)}. Free delivery over €60 applies to mainland Spain only ${cite(1)}.`,
    trace: `sources ≥ ${THRESHOLD}: ${hits("ship").length} · cited: ${hits("ship").length} · mode: answer`,
  },
  return: {
    text: `Yes, within 14 days, as long as it's unworn and still has its tags ${cite(2)}. The refund goes back to your card within 5 working days ${cite(3)}.`,
    trace: `sources ≥ ${THRESHOLD}: ${hits("return").length} · cited: ${hits("return").length} · mode: answer`,
  },
  everest: {
    text: "I don't have a reliable source for that, and I'd rather not guess about safety gear. Want me to pass you to someone in the shop?",
    trace: `sources ≥ ${THRESHOLD}: 0 · cited: 0 · mode: handoff to a human`,
  },
};

const steps = [
  { n: "01", when: "Before any code", title: "Use case & data", body: "Which questions or tasks, which content answers them, where it lives and what must never leave the client's systems." },
  { n: "02", when: "Pilot", title: "Pilot", body: "A working version on the real content, on a staging link, plus an eval set built from real customer questions." },
  { n: "03", when: "End of pilot", title: "Eval report", body: "Accuracy, citations, refusals, latency and cost per conversation, in writing. Go, adjust or stop, with numbers." },
  { n: "04", when: "Integration", title: "Integrate & launch", body: "Into the site, app or CMS: accessible UI, guardrails, analytics and a human handoff that actually reaches someone." },
  { n: "05", when: "After launch", title: "Monitor & improve", body: "Evals on every change, cost alerts, a monthly review of failed answers. Documentation and no lock-in to one model." },
];

const stack = [
  { k: "Models", v: ["Claude", "OpenAI", "Open models, on premise", "Swappable per task"] },
  { k: "Retrieval", v: ["Embeddings", "pgvector", "Supabase", "Hybrid search", "Reranking"] },
  { k: "Orchestration", v: ["Vercel AI SDK", "TypeScript", "PHP / Laravel", "Tool calling"] },
  { k: "Front-end", v: ["Astro", "WordPress", "WooCommerce", "Streaming chat UI"] },
  { k: "Quality", v: ["Eval sets in Git", "Guardrails", "Cost alerts"] },
];

const report = [
  { k: "Accuracy", v: "on your eval set of real questions" },
  { k: "Citations", v: "share of answers backed by a source" },
  { k: "Refusals", v: "out-of-scope questions it correctly declined" },
  { k: "Latency", v: "p95, first token and full answer" },
  { k: "Cost", v: "per 1,000 conversations, per model" },
];

// The only AI product work so far is a pilot on staging (docs/content-facts.md): never present it as production.
const pilot = {
  title: "Answers from a manufacturer's catalogues",
  client: "Manufacturer · pilot on staging",
  stack: ["Vercel AI SDK", "Embeddings", "RAG"],
  summary: "Hundreds of PDF pages turned into a chatbot that answers with the document and page it took the answer from. Built as a pilot: the numbers below decide whether it goes further.",
};

const faqs = [
  { q: "What is RAG, in plain words?", a: "Retrieval-augmented generation: before the model answers, the system looks up the most relevant passages in the client's own content and gives them to the model with the question. The answer is built from those passages and can cite them, instead of coming from the model's memory." },
  { q: "Will the chatbot make things up?", a: "It's the main risk, and it's managed, not wished away. Answers are grounded on retrieved sources, the assistant is told to decline when nothing relevant is found, and an eval set checks this on every change. Where a wrong answer is costly, it hands over to a human." },
  { q: "Which AI model do you use?", a: "Whichever fits the task, the language and the budget: usually Claude or OpenAI models, sometimes open models running on premise. The integration is built so the model can be swapped without rebuilding the product." },
  { q: "Where does the client's data go?", a: "We map it at kick-off. Where the models run is decided with you, project by project, based on the data involved. Personal data stays out of prompts unless it's needed and documented." },
  { q: "How much does it cost to run?", a: "There's no price list for the build: every project is scoped. Running costs depend on traffic and model, so the pilot measures the cost per conversation on real questions, and production gets a budget with alerts." },
  { q: "Can you add AI to an existing WordPress site?", a: "Yes. Search, an assistant or editorial tools can be added to a live WordPress or WooCommerce site as a plugin or a separate service, without rebuilding the theme." },
  { q: "Do you work white-label for agencies?", a: "When the project needs it, yes. I build AI features that agencies offer their own clients, under the agency's name and contract. Companies with an in-house product or marketing team can also work with me directly." },
];

const schema = [
  {
    "@context": "https://schema.org",
    "@type": "Service",
    "@id": `${PAGE}#service`,
    name: "LLM integration for websites and apps",
    serviceType: "AI product integration",
    description: "RAG chatbots with citations, semantic search, answers from PDFs and catalogues and AI inside WordPress, integrated into websites and apps for agencies and companies.",
    provider: { "@type": "Person", "@id": `${SITE}/#person`, name: "Pier Gorelli" },
    audience: { "@type": "BusinessAudience", audienceType: "Creative and digital agencies, companies with product or marketing teams" },
    areaServed: ["ES", "IT", "EU"],
    availableLanguage: ["en", "es", "it"],
    url: PAGE,
    hasOfferCatalog: {
      "@type": "OfferCatalog",
      name: "What I integrate",
      itemListElement: builds.map((b) => ({ "@type": "Offer", itemOffered: { "@type": "Service", name: b.title, description: b.body } })),
    },
  },
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    mainEntity: faqs.map((f) => ({ "@type": "Question", name: f.q, acceptedAnswer: { "@type": "Answer", text: f.a } })),
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    itemListElement: [
      { "@type": "ListItem", position: 1, name: "Home", item: `${SITE}/` },
      { "@type": "ListItem", position: 2, name: "Services", item: `${SITE}/services/` },
      { "@type": "ListItem", position: 3, name: "AI in products", item: PAGE },
    ],
  },
];
---

<Base
  title="LLM Integration & RAG Chatbots for Websites | Pier Gorelli"
  description="Freelance LLM integration developer: RAG chatbots that cite their sources, semantic search and answers from PDFs and catalogues, for websites and apps, for agencies and companies."
  motion="showcase"
  schema={schema}
>
  <!-- ── Hero ─────────────────────────────────────────────── -->
  <section class="hero wrap" data-hero>
    <nav class="note crumbs" aria-label="Breadcrumb">
      <a href="/" class="link">Home</a> / <a href="/services/" class="link">Services</a> / <span class="note--ink">AI in products</span>
    </nav>
    <p class="note">[Services / 02.3]</p>
    <h1 class="hero__title">
      <span class="display hero__human" data-hero-human data-bp="h1.human">Answers, with sources.</span>
      <span class="h2 hero__machine" data-hero-generate data-bp="h1.machine">LLM integration for websites and apps: a chatbot on your client's content, semantic search, answers from PDFs and catalogues.</span>
    </h1>
    <p class="note" data-hero-fade><span class="note--accent">◆</span> machine · generated · <span data-gen-tokens>24</span> tokens · <span data-gen-ms>1620</span> ms</p>

    <div class="hero__foot" data-hero-fade>
      <p class="lead">
        Before choosing a model, I write down the questions it must answer, the actions it may take and the point where a person steps in. Then I build the smallest pilot that can fail honestly.
      </p>
      <dl class="spec" data-bp="dl.tolerances">
        <div><dt class="note">Answers</dt><dd>Cited</dd></div>
        <div><dt class="note">Evals</dt><dd>Before launch</dd></div>
        <div><dt class="note">Hosting</dt><dd>Decided per project</dd></div>
        <div><dt class="note">Model</dt><dd>Swappable</dd></div>
      </dl>
    </div>
  </section>

  <!-- ── 01 Problem ───────────────────────────────────────── -->
  <section class="section wrap">
    <header class="section-head">
      <span class="note note--ink">[01] Where AI features break</span>
      <span class="note">Pain → fix</span>
    </header>
    <h2 class="h2 claim" data-reveal="lines">A demo takes a weekend. Production takes a method.</h2>
    <ol class="pains">
      {pains.map((p, i) => (
        <li class="pain grid-12" data-reveal="up">
          <span class="note pain__n">0{i + 1}</span>
          <p class="h3 pain__text">{p.pain}</p>
          <p class="pain__fix"><span class="note note--accent">fix →</span> {p.fix}</p>
        </li>
      ))}
    </ol>
  </section>

  <!-- ── 02 What I integrate ──────────────────────────────── -->
  <section class="section wrap">
    <header class="section-head">
      <span class="note note--ink">[02] What I integrate</span>
      <span class="note">{builds.length} types · agencies & companies</span>
    </header>
    <div class="builds grid-12">
      <div class="builds__figure">
        <ServiceFigure kind="product" caption="fig. 03 · retrieval: a question, its three nearest sources" />
      </div>
      <ol class="builds__list">
        {builds.map((b) => (
          <li class="build" data-reveal="up">
            <span class="note note--accent">{b.n}</span>
            <h3 class="h3">{b.title}</h3>
            <p>{b.body}</p>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <!-- ── 03 Retrieval lab ─────────────────────────────────── -->
  <section class="section wrap" aria-labelledby="lab-title">
    <header class="section-head">
      <span class="note note--ink">[03] Grounding, spec'd</span>
      <span class="note">Simulation · 0 KB of JavaScript</span>
    </header>
    <div class="lab-intro grid-12">
      <h2 class="h2 lab-intro__title" id="lab-title" data-reveal="lines">Grounded, or it doesn't answer.</h2>
      <p class="lead lab-intro__text" data-reveal="up">
        Every question is matched against the client's own content first. Only passages above a similarity threshold reach the model, the answer cites them, and when nothing clears the bar the assistant says so and calls a person.
      </p>
      <p class="lead lab-intro__text lab-intro__point" data-reveal="up">
        The third question is the one that matters. A useful assistant isn't the one that always answers. It's the one that knows when the sources aren't enough.
      </p>
    </div>

    <div class="rlab" data-reveal="up">
      <fieldset class="rlab__qs">
        <legend class="note note--ink">Ask the shop</legend>
        {questions.map((q, i) => (
          <label class="rlab__q" data-cursor="ask">
            <input type="radio" name="rq" value={q.id} id={`rq-${q.id}`} checked={i === 0} />
            <span class="rlab__q-text">“{q.q}”</span>
            <span class="note">{q.id === "everest" ? "Out of scope" : `${hits(q.id).length} sources match`}</span>
          </label>
        ))}
        <p class="note rlab__demo">A teaching simulation with a fictional outdoor shop. The scores are illustrative; the logic is the one I build.</p>
      </fieldset>

      <div class="rlab__stage">
        <div class="rlab__retrieve">
          <p class="note rlab__label"><span>01 · Retrieve</span><span>threshold {THRESHOLD.toFixed(2)}</span></p>
          <ol class="rlab__srcs">
            {sources.map((src, i) => (
              <li
                class="src"
                data-hit={questions.filter((q) => src.s[q.id] >= THRESHOLD).map((q) => q.id).join(" ")}
                style={questions.map((q) => `--s-${q.id}: ${src.s[q.id]}`).join("; ")}
              >
                <span class="src__n note">0{i + 1}</span>
                <span class="src__file note">{src.file}</span>
                <span class="src__score note">
                  {questions.map((q) => <span class:list={["src__val", `src__val--${q.id}`]}>{src.s[q.id].toFixed(2)}</span>)}
                </span>
                <span class="src__text">{src.text}</span>
                <span class="src__bar" aria-hidden="true"><span class="src__fill"></span></span>
              </li>
            ))}
          </ol>
        </div>

        <div class="rlab__answer" aria-live="polite">
          <p class="note rlab__label"><span>02 · Answer</span><span>model: any</span></p>
          {questions.map((q) => (
            <div class:list={["ans", `ans--${q.id}`]}>
              <p class="ans__text">{answers[q.id].text}</p>
              <p class="note ans__trace">{answers[q.id].trace}</p>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- ── 04 Process ───────────────────────────────────────── -->
  <section class="section wrap">
    <header class="section-head">
      <span class="note note--ink">[04] How a project runs</span>
      <span class="note">{steps.length} steps</span>
    </header>
    <h2 class="h2 claim" data-reveal="lines">A pilot on real content, then numbers.</h2>
    <div class="process__line" data-draw></div>
    <ol class="process grid-12">
      {steps.map((s) => (
        <li class="step" data-reveal="up">
          <span class="step__n">{s.n}</span>
          <span class="note">{s.when}</span>
          <h3 class="step__title">{s.title}</h3>
          <p>{s.body}</p>
        </li>
      ))}
    </ol>
  </section>

  <!-- ── 05 Stack ─────────────────────────────────────────── -->
  <section class="section wrap">
    <header class="section-head">
      <span class="note note--ink">[05] Stack</span>
      <span class="note">Model-agnostic · no lock-in</span>
    </header>
    <dl class="stack-table">
      {stack.map((s) => (
        <div class="stack-row grid-12" data-reveal="up">
          <dt class="h3">{s.k}</dt>
          <dd><ul class="stack">{s.v.map((t) => <li>{t}</li>)}</ul></dd>
        </div>
      ))}
    </dl>
  </section>

  <!-- ── 06 Pilot ─────────────────────────────────────────── -->
  <section class="section wrap">
    <header class="section-head">
      <span class="note note--ink">[06] What the pilot has to prove</span>
      <span class="note">Measured before anyone scales it</span>
    </header>
    <div class="cases grid-12">
      <article class="case case--0" data-reveal="up">
        <WorkVisual kind="catalogue" />
        <div class="case__meta note"><span>Pilot</span><span>{pilot.stack.join(" · ")}</span></div>
        <h3 class="h3">{pilot.title}</h3>
        <p class="note">{pilot.client}</p>
        <p class="case__summary">{pilot.summary}</p>
      </article>
      <div class="report" data-reveal="up">
        <p class="note note--ink">Every pilot ends with this report</p>
        <dl class="report__rows">
          {report.map((r) => (
            <div><dt class="h3">{r.k}</dt><dd>{r.v}</dd></div>
          ))}
        </dl>
      </div>
    </div>
  </section>

  <!-- ── 08 FAQ ───────────────────────────────────────────── -->
  <section class="section wrap">
    <header class="section-head">
      <span class="note note--ink">[07] FAQ</span>
      <span class="note">Updated · <time datetime={updated.toISOString().slice(0, 10)}>30 Sep 2026</time></span>
    </header>
    <div class="faqs">
      {faqs.map((f) => (
        <details class="faq" data-reveal="up">
          <summary><span class="h3">{f.q}</span><span class="faq__icon" aria-hidden="true"></span></summary>
          <p>{f.a}</p>
        </details>
      ))}
    </div>
  </section>

  <!-- ── 09 CTA ───────────────────────────────────────────── -->
  <section class="section wrap cta">
    <header class="section-head">
      <span class="note note--ink">[08] Next</span>
      <span class="note">30 minutes</span>
    </header>
    <h2 class="display cta__title" data-reveal="lines">Bring ten real questions.</h2>
    <p class="lead cta__text" data-reveal="up">The ones your client's customers actually ask. They become the first eval set, and the fastest way to see if AI is worth it.</p>
    <div class="cta__actions" data-reveal="up">
      <a href={CAL_URL} class="btn" target="_blank" rel="noopener">Book a 30-min call <span class="arrow">↗</span></a>
      <a href="/services/" class="btn btn--ghost">All services</a>
    </div>
  </section>
</Base>

<style>
  /* Hero */
  .hero {
    min-height: 92svh;
    display: flex;
    flex-direction: column;
    justify-content: end;
    gap: 1.25rem;
    padding-top: 7rem;
    padding-bottom: 2rem;
  }
  .crumbs { margin-bottom: auto; }
  .hero__title { display: flex; flex-direction: column; gap: 0.35em; font-weight: 500; }
  .hero__human { display: block; margin-left: -0.05em; }
  .hero__machine { display: block; max-width: 24ch; }
  .hero__foot {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: end;
    gap: 1.5rem 3rem;
    margin-top: 1.5rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--line);
  }
  .hero__foot .lead { max-width: 40ch; color: var(--muted); }
  .spec { display: grid; grid-template-columns: repeat(2, minmax(9rem, 1fr)); min-width: min(100%, 22rem); border-top: 1px solid var(--line); }
  .spec div { display: flex; justify-content: space-between; gap: 1rem; padding-block: 0.7rem; border-bottom: 1px solid var(--line); }
  .spec div:nth-child(odd) { padding-right: 1rem; box-shadow: inset -1px 0 var(--line); }
  .spec div:nth-child(even) { padding-left: 1rem; }

  .claim { max-width: 18ch; margin-bottom: clamp(2.5rem, 5vw, 4rem); }

  /* Pains */
  .pains { border-top: 1px solid var(--line); }
  .pain { align-items: baseline; row-gap: 0.75rem; padding-block: 1.75rem; border-bottom: 1px solid var(--line); }
  .pain__n { grid-column: 1; }
  .pain__text { grid-column: 2 / span 6; }
  .pain__fix { grid-column: 9 / -1; color: var(--muted); }
  @media (max-width: 767px) {
    .pain__n, .pain__text, .pain__fix { grid-column: 1 / -1; }
  }

  /* Builds */
  .builds { row-gap: 2.5rem; }
  .builds__figure { grid-column: 1 / span 5; }
  .builds__figure > :global(.sfig) { position: sticky; top: 6rem; }
  .builds__list { grid-column: 7 / -1; border-top: 1px solid var(--line); }
  .build { display: grid; grid-template-columns: 3.5rem 1fr; column-gap: 1rem; row-gap: 0.6rem; padding-block: 1.75rem; border-bottom: 1px solid var(--line); }
  .build .note { grid-row: span 2; padding-top: 0.5em; }
  .build p { color: var(--muted); max-width: 48ch; }
  @media (max-width: 899px) {
    .builds__figure, .builds__list { grid-column: 1 / -1; }
    .builds__figure > :global(.sfig) { position: static; max-width: 32rem; }
  }

  /* Retrieval lab */
  .lab-intro { row-gap: 1.5rem; align-items: end; margin-bottom: clamp(2.5rem, 5vw, 4rem); }
  .lab-intro__title { grid-column: 1 / span 6; max-width: 14ch; }
  .lab-intro__text { grid-column: 8 / -1; color: var(--muted); max-width: 40ch; }
  .lab-intro__point { grid-column: 8 / -1; color: var(--ink); }
  @media (max-width: 899px) { .lab-intro__title, .lab-intro__text { grid-column: 1 / -1; } }

  .rlab {
    display: grid;
    grid-template-columns: minmax(16rem, 4fr) 8fr;
    box-shadow: inset 0 0 0 1px var(--line-strong);
  }
  .rlab:has(#rq-ship:checked) .src { --s: var(--s-ship); }
  .rlab:has(#rq-return:checked) .src { --s: var(--s-return); }
  .rlab:has(#rq-everest:checked) .src { --s: var(--s-everest); }

  .rlab__qs { border: 0; margin: 0; padding: 1.5rem; display: flex; flex-direction: column; gap: 0.25rem; box-shadow: inset -1px 0 var(--line-strong); }
  .rlab__qs legend { float: left; width: 100%; margin-bottom: 1rem; }
  .rlab__q {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 0.3rem;
    padding: 0.85rem 1rem;
    border-radius: 6px;
    cursor: pointer;
    transition: background var(--dur-1) var(--ease-out), color var(--dur-1) var(--ease-out);
  }
  .rlab__q input { position: absolute; opacity: 0; pointer-events: none; }
  .rlab__q-text { font-size: var(--step-0); line-height: 1.35; }
  .rlab__q:hover { background: var(--bg-raised); }
  .rlab__q:has(:checked) { background: var(--ink); color: var(--bg); }
