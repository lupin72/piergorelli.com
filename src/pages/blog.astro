---
import Base from "../layouts/Base.astro";
import BlogIndex from "../components/rd/BlogIndex.astro";
import { getPosts, postUrl } from "../lib/blog";

const posts = await getPosts();
const site = Astro.site ?? new URL("https://piergorelli.com");

const schema = [
  {
    "@context": "https://schema.org",
    "@type": "Blog",
    "@id": "https://piergorelli.com/blog/#blog",
    name: "Pier Gorelli | Field notes",
    description: "Web development and applied AI, written from real agency projects.",
    url: "https://piergorelli.com/blog/",
    inLanguage: "en",
    author: { "@type": "Person", "@id": "https://piergorelli.com/#person", name: "Pier Gorelli", url: "https://piergorelli.com/about/" },
    blogPost: posts.map((p) => ({
      "@type": "BlogPosting",
      headline: p.data.title,
      url: new URL(postUrl(p), site).href,
      datePublished: p.data.pubDate.toISOString(),
    })),
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    itemListElement: [
      { "@type": "ListItem", position: 1, name: "Home", item: "https://piergorelli.com/" },
      { "@type": "ListItem", position: 2, name: "Blog", item: "https://piergorelli.com/blog/" },
    ],
  },
];
---

<Base
  title="Web Development & AI Blog | Pier Gorelli"
  description="Field notes on web development and applied AI from 25 years of agency work: Astro, GSAP, WordPress and LLM integrations."
  motion="read"
  schema={schema}
>
  <BlogIndex posts={posts} />
</Base>
