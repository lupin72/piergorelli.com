---
import { render } from "astro:content";
import { Image, getImage } from "astro:assets";
import Base from "../../layouts/Base.astro";
import { getPosts, pillarOf, pillarKeyOf, topicUrl, postUrl, wordCount, readingMinutes, formatDate, type Post } from "../../lib/blog";

export async function getStaticPaths() {
  const posts = await getPosts();
  return posts.map((post, i) => ({
    params: { slug: post.id },
    props: { post, next: posts[i + 1] ?? posts[0] },
  }));
}

interface Props {
  post: Post;
  next: Post;
}

const { post, next } = Astro.props;
const { Content, headings } = await render(post);
const toc = headings.filter((h) => h.depth === 2);
const og = await getImage({ src: post.data.cover, width: 1200, height: 630, format: "jpg" });
const site = Astro.site ?? new URL("https://piergorelli.com");
const url = new URL(postUrl(post), site).href;

const schema = [
  {
    "@context": "https://schema.org",
    "@type": "BlogPosting",
    headline: post.data.title,
    description: post.data.description,
    image: new URL(og.src, site).href,
    url,
    mainEntityOfPage: url,
    datePublished: post.data.pubDate.toISOString(),
    dateModified: post.data.pubDate.toISOString(),
    wordCount: wordCount(post),
    keywords: post.data.tags?.join(", "),
    articleSection: pillarOf(post),
    author: { "@type": "Person", "@id": "https://piergorelli.com/#person", name: "Pier Gorelli", url: "https://piergorelli.com/about/" },
    publisher: { "@type": "Person", "@id": "https://piergorelli.com/#person", name: "Pier Gorelli" },
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    itemListElement: [
      { "@type": "ListItem", position: 1, name: "Home", item: "https://piergorelli.com/" },
      { "@type": "ListItem", position: 2, name: "Blog", item: "https://piergorelli.com/blog/" },
      { "@type": "ListItem", position: 3, name: post.data.title, item: url },
    ],
  },
];

const meta = [
  ["Pillar", pillarOf(post)],
  ["Published", formatDate(post.data.pubDate)],
  ["Reading", `${readingMinutes(post)} min`],
  ["Words", wordCount(post).toLocaleString("en")],
];
---

<Base title={`${post.data.title} | Pier Gorelli`} description={post.data.description} motion="read" type="article" image={og.src} imageAlt={post.data.title} schema={schema}>
  <article class="article wrap">
    <header class="article__head">
      <nav class="note crumbs" aria-label="Breadcrumb">
        <a href="/" class="link">Home</a> / <a href="/blog/" class="link">Blog</a> / <a href={topicUrl(pillarKeyOf(post))} class="link note--ink">{pillarOf(post)}</a>
      </nav>
      <h1 class="h1 article__title">{post.data.title}</h1>
      <p class="lead article__desc">{post.data.description}</p>
      <dl class="article__meta grid-12">
        {meta.map(([k, v]) => (
          <div><dt class="note">{k}</dt><dd>{v}</dd></div>
        ))}
      </dl>
    </header>

    <figure class="article__cover">
      <Image src={post.data.cover} alt={post.data.alt} widths={[640, 1024, 1600]} sizes="(min-width: 1024px) 80vw, 100vw" loading="eager" fetchpriority="high" />
      <figcaption class="note">fig. 00 · {post.data.alt}</figcaption>
    </figure>

    <div class="article__body grid-12">
      {toc.length > 1 && (
        <aside class="toc">
          <p class="note note--ink">Contents</p>
          <ol>
            {toc.map((h, i) => (
              <li><a href={`#${h.slug}`} class="link"><span class="note">{String(i + 1).padStart(2, "0")}</span> {h.text}</a></li>
            ))}
          </ol>
        </aside>
      )}
      <div class="prose">
        <Content />
      </div>
    </div>

    <footer class="article__foot grid-12">
      <div class="author">
        <p class="note">Written by</p>
        <p class="h3">Pier Gorelli</p>
        <p class="author__bio">Freelance web &amp; AI developer for creative agencies. 25 years of shipping, based in Valencia.</p>
        <a href="/contact/" class="btn">Work with me <span class="arrow">→</span></a>
      </div>
      <a href={postUrl(next)} class="next">
        <span class="note">Next post · {pillarOf(next)}</span>
        <span class="h2 next__title">{next.data.title}</span>
      </a>
    </footer>
  </article>
</Base>

<style>
  .article { padding-top: 7rem; }
  .article__head { display: flex; flex-direction: column; gap: 1.5rem; }
  .article__title { font-size: clamp(2.4rem, 1.2rem + 5vw, 6.5rem); max-width: 18ch; }
  .article__desc { max-width: 52ch; color: var(--muted); }
  .article__meta {
    margin-top: 1rem;
    padding-top: 0.75rem;
    border-top: 1px solid var(--line-strong);
    row-gap: 1rem;
  }
  .article__meta > div { grid-column: span 3; display: flex; flex-direction: column; gap: 0.25rem; }
  @media (max-width: 767px) { .article__meta > div { grid-column: span 2; } }

  .article__cover { margin-top: clamp(2.5rem, 5vw, 4.5rem); }
  .article__cover :global(img) { width: 100%; aspect-ratio: 16 / 8; object-fit: cover; border-radius: 4px; }
  .article__cover figcaption { margin-top: 0.75rem; }

  .article__body { margin-top: clamp(3rem, 7vw, 7rem); align-items: start; }
  .toc { grid-column: 1 / span 3; position: sticky; top: 6rem; display: flex; flex-direction: column; gap: 1rem; }
  .toc ol { display: flex; flex-direction: column; gap: 0.6rem; font-size: 0.92rem; }
  .toc a { color: var(--muted); }
  .toc a:hover { color: var(--ink); }
  .prose { grid-column: 5 / span 7; min-width: 0; }
  @media (max-width: 1023px) {
    .toc { display: none; }
    .prose { grid-column: 1 / -1; max-width: 70ch; }
  }

  /* Long-form typography */
  .prose { font-size: 1.125rem; line-height: 1.7; }
  .prose :global(> * + *) { margin-top: 1.25em; }
  .prose :global(h2) { font-size: var(--step-2); margin-top: 2.6em; scroll-margin-top: 6rem; }
  .prose :global(h3) { font-size: var(--step-1); margin-top: 2em; letter-spacing: -0.02em; line-height: 1.2; scroll-margin-top: 6rem; }
  .prose :global(a) { overflow-wrap: anywhere; color: var(--ink); text-decoration: underline; text-decoration-color: var(--accent-text); text-underline-offset: 0.2em; text-decoration-thickness: 2px; }
  .prose :global(a:hover) { color: var(--accent-text); }
  .prose :global(strong) { font-weight: 600; }
  .prose :global(ul), .prose :global(ol) { padding-left: 1.25em; }
  .prose :global(ul) { list-style: square; }
  .prose :global(ol) { list-style: decimal; }
  .prose :global(li + li) { margin-top: 0.4em; }
  .prose :global(li::marker) { color: var(--accent-text); }
  .prose :global(blockquote) { border-left: 2px solid var(--accent); padding-left: 1.25em; font-size: var(--step-1); line-height: 1.4; }
  .prose :global(hr) { border: 0; border-top: 1px solid var(--line); margin-block: 3em; }
  .prose :global(img) { border-radius: 4px; }
  .prose :global(:not(pre) > code) {
    font-family: var(--font-mono);
    font-size: 0.88em;
    padding: 0.1em 0.35em;
    border-radius: 4px;
    background: var(--bg-raised);
    box-shadow: inset 0 0 0 1px var(--line);
  }
  .prose :global(pre) {
    font-family: var(--font-mono);
    font-size: 0.88rem;
    line-height: 1.6;
    padding: 1.25rem 1.4rem;
    border-radius: 8px;
    overflow-x: auto;
  }
  .prose :global(table) { width: 100%; border-collapse: collapse; font-size: 0.95rem; }
  .prose :global(th), .prose :global(td) { text-align: left; padding: 0.6rem 0.5rem; border-bottom: 1px solid var(--line); }

  .article__foot { margin-top: var(--section); padding-top: 2rem; border-top: 1px solid var(--line-strong); row-gap: 3rem; }
  .author { grid-column: 1 / span 5; display: flex; flex-direction: column; gap: 0.75rem; align-items: start; }
  .author__bio { color: var(--muted); max-width: 36ch; margin-bottom: 0.5rem; }
  .next { grid-column: 7 / -1; display: flex; flex-direction: column; gap: 1rem; }
  .next__title { transition: color var(--dur-1) var(--ease-out); }
  .next:hover .next__title { color: var(--accent-text); }
  @media (max-width: 767px) { .author, .next { grid-column: 1 / -1; } }
</style>
